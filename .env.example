# NYVEN — Cloudflare Auth + D1 (Supabase Auth removed)
# Public app origin (CORS + email links). Production must be https.
APP_URL=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example

# Optional session pepper (recommended in production)
AUTH_SESSION_SECRET=

# D1 is bound as DB in wrangler.toml / Pages (nyven-db)

# Cloudflare Pages / Functions secrets (never VITE_ for secrets)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_VOICE=933563129e564b19a115bedd57b7406a

BREVO_API_KEY=
BREVO_FROM_NAME=NYVEN Support
BREVO_FROM_EMAIL=
NYVEN_FEEDBACK_EMAIL=hellovexdyn@gmail.com
SUPPORT_INBOX=hellovexdyn@gmail.com

# GitHub connector (OAuth app)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CONNECTOR_TOKEN_SECRET=

# Shared Gmail inbox disabled by default
# ENABLE_SHARED_GMAIL_INBOX=true
# GMAIL_ACCESS_TOKEN=
# GMAIL_REFRESH_TOKEN=

# Provider budgets (optional)
# PROVIDER_BUDGET_OPENROUTER=40
