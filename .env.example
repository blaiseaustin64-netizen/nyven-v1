# Public (Vite) — safe with RLS
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Cloudflare Worker / Pages Functions — JWT verification (same project values OK)
# Prefer non-VITE names on the server; fallbacks accept VITE_* if already set.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Cloudflare Pages / Functions secrets (never VITE_)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
# Optional search
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
# Optional STT (OpenAI-compatible transcriptions — NOT required for text chat or TTS)
# STT_API_BASE=https://api.example.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1
# Or OpenRouter only if your account exposes STT:
# OPENROUTER_STT_MODEL=
# Optional TTS overrides
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_VOICE=de77377323004b48937473a795d86f1f

# Server-only later (OAuth / service role — never ship to client)
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
