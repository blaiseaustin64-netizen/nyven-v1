# Public (Vite) — safe with RLS
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Cloudflare Worker / Pages Functions — JWT verification (same project values OK)
# Prefer non-VITE names on the server; fallbacks accept VITE_* if already set.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Cloudflare Pages / Functions secrets (never VITE_)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
# Optional search
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
# STT — primary: Cloudflare Workers AI binding named `AI` (no key)
# Optional Groq fallback:
# GROQ_API_KEY=
# STT_MODEL=whisper-large-v3-turbo


# Optional TTS overrides
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_VOICE=de77377323004b48937473a795d86f1f

# Server-only later (OAuth / service role — never ship to client)
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth (Phase 8B) — Cloudflare secrets, never VITE_
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CONNECTOR_TOKEN_SECRET=
# Required for OAuth callback to write encrypted tokens
SUPABASE_SERVICE_ROLE_KEY=
# REQUIRED for OAuth. Explicit public origin only (no path). Production must be https.
# The callback URL and redirects are built from this value; it is never derived from the request.
# Local `wrangler pages dev` on your machine may use http://localhost:8788 (loopback only).
APP_URL=
