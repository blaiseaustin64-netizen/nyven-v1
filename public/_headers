# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
# The shell files must always be revalidated so a new deploy is picked up;
# hashed build assets never change, so they are cached for a year.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
